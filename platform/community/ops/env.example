# Store actual values outside git in a protected 0600 file.
NODE_ENV=production
COMMUNITY_DB_PATH=/srv/amu-staging/community-staging.db
COMMUNITY_PORT=3861
COMMUNITY_ORIGIN=https://affiliatemeetups.com
COMMUNITY_BASE_PATH=/staging
COMMUNITY_RATE_SECRET=
COMMUNITY_ADMIN_TOKEN=
COMMUNITY_ADMIN_TOTP_SECRET=
COMMUNITY_MAIL_MODE=smtp
COMMUNITY_SMTP_HOST=
COMMUNITY_SMTP_PORT=587
COMMUNITY_SMTP_USER=
COMMUNITY_SMTP_PASSWORD=
COMMUNITY_MAIL_FROM=
# No credentials for Telegram, Cyberimpact marketing, n8n or other XenTraffic apps required.
# Unapproved price proposals. Leave empty until a number is approved. Do not commit a price.
COMMUNITY_PRICE_SLOT=
COMMUNITY_PRICE_PRO=
COMMUNITY_PRICE_CURRENCY=
# Set to 0 to force every sponsored slot off. Otherwise each slot flag in settings defaults off.
COMMUNITY_SPONSORED_SLOTS=
# Optional label overrides. Empty uses the database defaults.
COMMUNITY_OFFER_DISCLOSURE=
COMMUNITY_OPERATOR_LABEL=
COMMUNITY_OPERATOR_TOOLTIP=
COMMUNITY_SPONSORED_LABEL=
COMMUNITY_SPONSORED_TOOLTIP=
COMMUNITY_SPONSORED_DISCLOSURE=
COMMUNITY_NIGHT_OWL_START=
COMMUNITY_NIGHT_OWL_END=
# Pro grace length in days. Empty means the grace_elapsed transition is refused.
COMMUNITY_PRO_GRACE_DAYS=
COMMUNITY_PRO_TRIALS=
