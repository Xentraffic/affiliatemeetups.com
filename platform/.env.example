# Members directory. Leave unset to keep GET /api/members closed.
AMU_MEMBERS_READ_TOKEN=

# Waitlist database. Defaults to platform/waitlist.db next to the server.
WAITLIST_DB_PATH=
WAITLIST_PEPPER=
WAITLIST_EMAIL_LIMIT=5
WAITLIST_IP_LIMIT=20
WAITLIST_WINDOW_SEC=3600

# Cyberimpact forward is off unless this is exactly 1.
# Payload remains email, first name, last name, and group 129.
CYBERIMPACT_FORWARD=
CYBERIMPACT_API_KEY=
GROUP_AMU=129

# Email provider is not chosen. log is the default. brevo is rejected.
# smtp uses SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM and the nodemailer package.
EMAIL_MODE=log
EMAIL_LOG_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
